# Keep reviewed verification logs, not new ad-hoc simulator transcripts.
/results/
/msu_sv/results/modelsim.log
/fifo_sv/test_logs/

# Publication review: retain these locally until ownership/privacy approval.
# These rules DO NOT remove files already in the index or Git history.
/*.pdf
/*.docx
/*.xlsx
/meeting簡報/
/圖片/

# The byte-identical baseline is distributed as c_vectors.txt.gz.
# Restore with tools/restore_vectors.ps1 before replaying the TC unit test.
# The original 150 MB blob is still in local history; do not push it as-is.
/tensor_core_sv/c_vectors.txt

# Credentials/local configuration; no matches are required for these rules.
.env
.env.*
!.env.example
*.pem
*.key

# Source, C headers, vectors (except the raw TC file above), .f/.do/.tcl,
# .ps1/.sh/.bat, .xdc/.xpr/.vcxproj settings and selected .log/.rpt stay eligible.
# Ignore rules never delete files or sanitize existing commits.
