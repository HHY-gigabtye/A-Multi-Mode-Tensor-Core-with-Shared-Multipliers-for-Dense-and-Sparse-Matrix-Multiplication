diff --git a/experiments/pre_route_20261122/tb_pre_route_equiv.sv b/experiments/pre_route_20261122/tb_pre_route_equiv.sv
new file mode 100644
index 0000000..438a4c6
--- /dev/null
+++ b/experiments/pre_route_20261122/tb_pre_route_equiv.sv
@@ -0,0 +1,202 @@
+`timescale 1ns/1ps
+
+// Standalone common-stimulus comparison against the unchanged production core.
+// The additional matrix oracle uses original coordinates, independently of
+// either RTL routing network. Existing tests, seeds and vectors are untouched.
+module tb_pre_route_equiv;
+  import tensor_core_pkg::*;
+  logic clk = 0, rst_n = 1, in_valid = 0, result_ready = 0;
+  tc_sparse_payload_t in_packet;
+  logic ref_ready, dut_ready, ref_valid, dut_valid, ref_busy, dut_busy;
+  tc_matrix_t ref_result, dut_result;
+  tc_status_t ref_status, dut_status;
+  tc_tick_info_t ref_info, dut_info;
+  bit passed = 0;
+  outer_product_core_baseline reference_core (
+    .clk(clk), .rst_n(rst_n), .in_valid(in_valid), .result_ready(result_ready),
+    .in_packet(in_packet), .in_ready(ref_ready), .result_valid(ref_valid),
+    .busy(ref_busy), .result(ref_result), .status(ref_status), .tick_info(ref_info)
+  );
+  outer_product_core candidate_core (
+    .clk(clk), .rst_n(rst_n), .in_valid(in_valid), .result_ready(result_ready),
+    .in_packet(in_packet), .in_ready(dut_ready), .result_valid(dut_valid),
+    .busy(dut_busy), .result(dut_result), .status(dut_status), .tick_info(dut_info)
+  );
+
+  tc_matrix_t expected_results[$];
+  int publication_due[$];
+  tc_matrix_t expected_acc, consumed;
+  int input_k = 0, advancing = 0;
+  int edges = 0, accepted = 0, completed = 0, publications = 0;
+  int rejected = 0, malformed = 0, full_rejects = 0, resets = 0;
+  int simultaneous = 0, stored_zero = 0, bitmap_pairs = 0;
+  logic [31:0] random_state = 32'h7a913b65;
+
+  function automatic logic [31:0] next_random();
+    random_state = random_state ^ (random_state << 13);
+    random_state = random_state ^ (random_state >> 17);
+    random_state = random_state ^ (random_state << 5);
+    return random_state;
+  endfunction
+
+  function automatic tc_sparse_vector_t make_vector(input logic [7:0] mask, input int salt);
+    tc_sparse_vector_t vector_data;
+    int rank;
+    vector_data = '0;
+    rank = 0;
+    // Padding deliberately carries arbitrary nonzero data and indices.
+    for (int n = 0; n < 8; n++) begin
+      vector_data.value[n] = 8'(salt + 41*n + 1);
+      vector_data.index[n] = 3'(7-n);
+    end
+    for (int coord = 0; coord < 8; coord++) begin
+      if (mask[coord]) begin
+        vector_data.index[rank] = 3'(coord);
+        case ((salt + coord) % 6)
+          0: vector_data.value[rank] = 8'h80;
+          1: vector_data.value[rank] = 8'h7f;
+          2: vector_data.value[rank] = 8'h00;
+          3: vector_data.value[rank] = 8'hff;
+          4: vector_data.value[rank] = 8'h01;
+          default: vector_data.value[rank] = 8'(salt ^ (coord*29));
+        endcase
+        rank++;
+      end
+    end
+    vector_data.count = 4'(rank);
+    return vector_data;
+  endfunction
+
+  task automatic compare_state;
+    if ({dut_ready,dut_valid,dut_busy,dut_status} !==
+        {ref_ready,ref_valid,ref_busy,ref_status})
+      $fatal(1, "Interface mismatch at edge %0d", edges);
+    if (dut_result !== ref_result || dut_info !== ref_info ||
+        candidate_core.tail !== reference_core.tail ||
+        candidate_core.acc !== reference_core.acc ||
+        candidate_core.next_k !== reference_core.next_k ||
+        candidate_core.outstanding !== reference_core.outstanding ||
+        candidate_core.result_count !== reference_core.result_count)
+      $fatal(1, "State/payload/event mismatch at edge %0d", edges);
+  endtask
+
+  task automatic step;
+    bit expect_publish;
+    int i, j, product;
+    #1;
+    compare_state();
+    expect_publish = 0;
+    if (!rst_n) begin
+      expected_results.delete();
+      publication_due.delete();
+      expected_acc = '0;
+      input_k = 0;
+      advancing = 0;
+      resets++;
+    end else if (ref_status == TC_OK) begin
+      if (publication_due.size() != 0 && publication_due[0] == advancing) begin
+        expect_publish = 1;
+        void'(publication_due.pop_front());
+      end
+      if (ref_valid && result_ready) begin
+        if (expected_results.size() == 0) $fatal(1, "Unexpected result");
+        consumed = expected_results.pop_front();
+        if (ref_result !== consumed || dut_result !== consumed)
+          $fatal(1, "Independent GEMM mismatch at edge %0d", edges);
+        completed++;
+        if (in_valid) simultaneous++;
+      end
+      if (in_valid) begin
+        if (input_k == 0) expected_acc = '0;
+        for (int p = 0; p < int'(in_packet.a.count); p++) begin
+          if (in_packet.a.value[p] == 0) stored_zero++;
+          for (int r = 0; r < int'(in_packet.b.count); r++) begin
+            i = int'(in_packet.a.index[p]);
+            j = int'(in_packet.b.index[r]);
+            product = int'($signed(in_packet.a.value[p])) * int'($signed(in_packet.b.value[r]));
+            expected_acc[i][j] = 32'($signed(expected_acc[i][j]) + product);
+          end
+        end
+        if (input_k == 7) begin
+          expected_results.push_back(expected_acc);
+          publication_due.push_back(advancing + 3);
+        end
+        input_k = (input_k + 1) % 8;
+        accepted++;
+      end
+      advancing++;
+    end else begin
+      rejected++;
+      if (ref_status == TC_BAD_SPARSE_VECTOR) malformed++;
+      if (ref_status == TC_NOT_READY) full_rejects++;
+    end
+    clk = 1; #1;
+    compare_state();
+    if (dut_info.result_produced !== expect_publish)
+      $fatal(1, "Publication latency mismatch at edge %0d", edges);
+    if (expect_publish) publications++;
+    clk = 0; #1;
+    edges++;
+  endtask
+
+  task automatic reset_core;
+    rst_n = 0; in_valid = 0; result_ready = 0; step(); rst_n = 1;
+  endtask
+
+  task automatic drain;
+    in_valid = 0; result_ready = 1;
+    repeat (20) step();
+    if (expected_results.size() != 0 || publication_due.size() != 0 || ref_busy)
+      $fatal(1, "Drain incomplete");
+  endtask
+
+  initial begin
+    logic [31:0] random_bits;
+    in_packet = '0;
+    reset_core();
+    // Exhaust every pair of legal A/B coordinate subsets (including empty
+    // and full vectors). Padding values are not allowed to affect results.
+    for (int a_mask = 0; a_mask < 256; a_mask++) begin
+      for (int b_mask = 0; b_mask < 256; b_mask++) begin
+        result_ready = 1; in_valid = 0; #1;
+        while (!ref_ready) step();
+        in_packet.a = make_vector(8'(a_mask), a_mask + b_mask);
+        in_packet.b = make_vector(8'(b_mask), a_mask + 2*b_mask + 1);
+        in_valid = 1; step(); bitmap_pairs++;
+      end
+    end
+    drain();
+    // Random bubbles, full-result offers, malformed metadata and resets in
+    // flight. The strict contract rejects an entire edge, including a pop.
+    for (int cycle = 0; cycle < 24000; cycle++) begin
+      random_bits = next_random();
+      rst_n = (cycle % 137 != 0);
+      in_valid = (random_bits[3:0] != 0);
+      result_ready = random_bits[7:4] < 4'd7;
+      in_packet.a = make_vector(random_bits[15:8], cycle);
+      in_packet.b = make_vector(random_bits[23:16], cycle + 11);
+      case (random_bits[27:24])
+        0: in_packet.a.count = 4'd9;
+        1: begin in_packet.b.count = 4'd2; in_packet.b.index[0] = 3'd4; in_packet.b.index[1] = 3'd4; end
+        2: begin in_packet.a.count = 4'd2; in_packet.a.index[0] = 3'd7; in_packet.a.index[1] = 3'd1; end
+        default: ;
+      endcase
+      step();
+    end
+    reset_core();
+    // Explicit full-credit rejection on a simultaneous requested result pop.
+    in_packet.a = make_vector(8'hff, 0);
+    in_packet.b = make_vector(8'hff, 1);
+    in_valid = 1; result_ready = 0;
+    repeat (16) step();
+    result_ready = 1; step();
+    drain();
+    if (bitmap_pairs != 65536 || completed < 8194 || malformed == 0 ||
+        full_rejects == 0 || simultaneous == 0 || stored_zero == 0)
+      $fatal(1, "Insufficient test coverage");
+    $display("PRE_ROUTE EQUIVALENCE PASS edges=%0d bitmap_pairs=%0d accepted=%0d completed=%0d publications=%0d malformed=%0d full_rejects=%0d resets=%0d simultaneous=%0d stored_zero=%0d seed=7a913b65",
+      edges, bitmap_pairs, accepted, completed, publications, malformed,
+      full_rejects, resets, simultaneous, stored_zero);
+    passed = 1; $finish;
+  end
+endmodule
diff --git a/experiments/pre_route_20261122/power/tb_power.sv b/experiments/pre_route_20261122/power/tb_power.sv
new file mode 100644
index 0000000..5ef324d
--- /dev/null
+++ b/experiments/pre_route_20261122/power/tb_power.sv
@@ -0,0 +1,239 @@
+`timescale 1ns/1ps
+// Additional power workload only. Existing verification sources are untouched.
+// No DUT internals or forces: identical memory transactions for RTL and netlist.
+module tb_power;
+  localparam int TILES = 288;
+  logic clk = 0;
+  always #5 clk = ~clk;
+  logic rst_n = 0;
+  logic command_valid = 0, command_ready, read_request_valid, read_request_ready = 0;
+  logic read_data_valid = 0, read_data_ready, read_last = 0, write_valid, write_ready = 0;
+  logic write_last, tile_done;
+  logic [63:0] read_addr, write_addr;
+  logic [2:0] read_beats;
+  mlu_pkg::io_command_t command = '0;
+  mlu_pkg::io_beat_t read_data = '0;
+  msu_pkg::msu_beat_t write_data;
+  msu_pkg::io_meta_t write_meta, completed;
+  logic [2:0] mlu_status, bridge_status, tc_status, msu_status;
+`ifdef POWER_NETLIST
+  // Vivado expands packed struct/array ports in the generated timing netlist.
+  sparse_tensor_core_top dut (
+    .\command[mode] (command.mode),
+    .\command[src_addr] (command.src_addr),
+    .\command[meta][tile_id] (command.meta.tile_id),
+    .\command[meta][dst_addr] (command.meta.dst_addr),
+    .\read_data[0] (read_data[0]),
+    .\read_data[1] (read_data[1]),
+    .\read_data[2] (read_data[2]),
+    .\read_data[3] (read_data[3]),
+    .\read_data[4] (read_data[4]),
+    .\read_data[5] (read_data[5]),
+    .\read_data[6] (read_data[6]),
+    .\read_data[7] (read_data[7]),
+    .\read_data[8] (read_data[8]),
+    .\read_data[9] (read_data[9]),
+    .\read_data[10] (read_data[10]),
+    .\read_data[11] (read_data[11]),
+    .\read_data[12] (read_data[12]),
+    .\read_data[13] (read_data[13]),
+    .\read_data[14] (read_data[14]),
+    .\read_data[15] (read_data[15]),
+    .\read_data[16] (read_data[16]),
+    .\read_data[17] (read_data[17]),
+    .\read_data[18] (read_data[18]),
+    .\read_data[19] (read_data[19]),
+    .\read_data[20] (read_data[20]),
+    .\read_data[21] (read_data[21]),
+    .\read_data[22] (read_data[22]),
+    .\read_data[23] (read_data[23]),
+    .\read_data[24] (read_data[24]),
+    .\read_data[25] (read_data[25]),
+    .\read_data[26] (read_data[26]),
+    .\read_data[27] (read_data[27]),
+    .\read_data[28] (read_data[28]),
+    .\read_data[29] (read_data[29]),
+    .\read_data[30] (read_data[30]),
+    .\read_data[31] (read_data[31]),
+    .\write_meta[tile_id] (write_meta.tile_id),
+    .\write_meta[dst_addr] (write_meta.dst_addr),
+    .\completed[tile_id] (completed.tile_id),
+    .\completed[dst_addr] (completed.dst_addr),
+    .*
+  );
+`else
+  sparse_tensor_core_top dut (.*);
+`endif
+
+  int a[TILES][8][8], b[TILES][8][8];
+  logic [7:0] keep_a[TILES][8], keep_b[TILES][8];
+  logic [3:0] masks[TILES][2][8];
+  logic [7:0] image_bytes[TILES][160];
+  tensor_core_pkg::tc_matrix_t expected[TILES];
+  mlu_pkg::io_command_t commands[TILES];
+  logic [31:0] rng = 32'h51a7c0de;
+  int mode = 0, cycle = 0, submitted = 0, requests = 0, beats = 0, dones = 0;
+  int active_tile = 0, active_beat = 0, active_beats = 0, last_done_cycle = -1;
+  int present_a = 0, present_b = 0, nonzero_a = 0, nonzero_b = 0;
+  bit memory_active = 0, passed = 0, previous_last = 0;
+  msu_pkg::io_meta_t previous_meta = '0;
+  integer trace_fd;
+
+  function automatic logic [31:0] random_word();
+    rng = rng ^ (rng << 13);
+    rng = rng ^ (rng >> 17);
+    rng = rng ^ (rng << 5);
+    return rng;
+  endfunction
+  function automatic logic [3:0] mask_at(input int n);
+    case (n%6)
+      0: return 4'h3; 1: return 4'h5; 2: return 4'h6;
+      3: return 4'h9; 4: return 4'ha; default: return 4'hc;
+    endcase
+  endfunction
+  task automatic check(input bit condition, input string message);
+    if (!condition) $fatal(1,"POWER WORKLOAD FAIL mode=%0d cycle=%0d: %s",mode,cycle,message);
+  endtask
+  task automatic prepare;
+    int off, rank_a, rank_b, sum;
+    logic [31:0] sample;
+    for (int t=0; t<TILES; t++) begin
+      commands[t] = '0;
+      commands[t].mode = mlu_pkg::io_mode_t'(mode);
+      commands[t].src_addr = 64'h0000_0001_0000_0000 + 64'(t)*256;
+      commands[t].meta.dst_addr = 64'h0000_0002_0000_0000 + 64'(t)*512;
+      commands[t].meta.tile_id = 32'h8000_0000 + 32'(t);
+      for (int n=0; n<160; n++) image_bytes[t][n] = 0;
+      for (int g=0; g<2; g++)
+        for (int j=0; j<8; j++) begin
+          sample = random_word();
+          masks[t][g][j] = mask_at(int'(sample % 6));
+        end
+      for (int k=0; k<8; k++) begin
+        sample = random_word(); keep_a[t][k] = mode == 0 ? 8'hff : sample[7:0];
+        sample = random_word(); keep_b[t][k] = mode == 0 ? 8'hff : sample[7:0];
+        if (mode == 1)
+          for (int j=0; j<8; j++) keep_b[t][k][j] = masks[t][k/4][j][k%4];
+        for (int i=0; i<8; i++) begin
+          sample = random_word(); a[t][i][k] = keep_a[t][k][i] ? int'($signed(sample[7:0])) : 0;
+          sample = random_word(); b[t][k][i] = keep_b[t][k][i] ? int'($signed(sample[7:0])) : 0;
+          present_a += int'(keep_a[t][k][i]); present_b += int'(keep_b[t][k][i]);
+          if (a[t][i][k] != 0) nonzero_a++;
+          if (b[t][k][i] != 0) nonzero_b++;
+        end
+      end
+      for (int i=0; i<8; i++)
+        for (int j=0; j<8; j++) begin
+          sum = 0;
+          for (int k=0; k<8; k++) sum += a[t][i][k]*b[t][k][j];
+          expected[t][i][j] = 32'(sum);
+        end
+      // Independent encoder of the documented dense/hybrid/dual memory layout.
+      for (int k=0; k<8; k++) begin
+        rank_a = 0; rank_b = 0;
+        if (mode == 0) begin
+          for (int i=0; i<8; i++) begin
+            image_bytes[t][16*k+i] = 8'(a[t][i][k]);
+            image_bytes[t][16*k+8+i] = 8'(b[t][k][i]);
+          end
+        end else begin
+          off = mode == 1 ? 9*k : 18*k;
+          image_bytes[t][off] = keep_a[t][k];
+          if (mode == 2) image_bytes[t][off+9] = keep_b[t][k];
+          for (int i=0; i<8; i++) begin
+            if (keep_a[t][k][i]) begin
+              image_bytes[t][off+1+rank_a] = 8'(a[t][i][k]); rank_a++;
+            end
+            if (mode == 2 && keep_b[t][k][i]) begin
+              image_bytes[t][off+10+rank_b] = 8'(b[t][k][i]); rank_b++;
+            end
+          end
+        end
+      end
+      if (mode == 1)
+        for (int g=0; g<2; g++)
+          for (int j=0; j<8; j++) begin
+            off = 72+24*g+3*j;
+            image_bytes[t][off] = {4'd0,masks[t][g][j]}; rank_b = 0;
+            for (int p=0; p<4; p++)
+              if (masks[t][g][j][p]) begin
+                image_bytes[t][off+1+rank_b] = 8'(b[t][4*g+p][j]); rank_b++;
+              end
+          end
+    end
+  endtask
+
+  task automatic tick;
+    bit cf, rf, df, wf;
+    int t, row;
+    @(negedge clk);
+    if (!command_valid && submitted < TILES) begin
+      command = commands[submitted]; command_valid = 1;
+    end
+    read_request_ready = 1; write_ready = 1;
+    if (!read_data_valid && memory_active) begin
+      for (int n=0; n<32; n++) read_data[n] = image_bytes[active_tile][32*active_beat+n];
+      read_last = active_beat == active_beats-1; read_data_valid = 1;
+    end
+    @(posedge clk);
+    check(mlu_status === mlu_pkg::IO_OK && bridge_status === du_tc_bridge_pkg::IO_OK &&
+          tc_status === tensor_core_pkg::TC_OK && msu_status === msu_pkg::IO_OK,"status");
+    cf = command_valid && command_ready; rf = read_request_valid && read_request_ready;
+    df = read_data_valid && read_data_ready; wf = write_valid && write_ready;
+    check(tile_done === previous_last, "completion timing");
+    if (previous_last) check(completed === previous_meta,"completion metadata");
+    $fdisplay(trace_fd,"%0d %h %b %h %b%b %h %b %b %b%b%b%b %h %h %h %b",cycle,
+      command,command_valid,read_data,read_data_valid,read_last,read_request_ready,
+      write_ready,rst_n,cf,rf,df,wf,read_addr,write_addr,write_data,write_last);
+    if (cf) submitted++;
+    if (rf) begin
+      check(!memory_active && requests < submitted,"single read burst");
+      check(read_addr === commands[requests].src_addr,"read order/address");
+      check(read_beats == (mode == 2 ? 5 : 4),"read length");
+      active_tile = requests; active_beat = 0; active_beats = int'(read_beats);
+      memory_active = 1; requests++;
+    end
+    if (df) begin
+      check(memory_active && !rf,"response follows request"); active_beat++;
+      if (read_last) memory_active = 0;
+    end
+    previous_last = wf && write_last; previous_meta = write_meta;
+    if (wf) begin
+      t = beats/8; row = beats%8;
+      check(t < TILES,"extra result");
+      check(write_meta === commands[t].meta,"write order/metadata");
+      check(write_addr === commands[t].meta.dst_addr + 64'(32*row),"write address");
+      check(write_last === (row == 7),"last beat");
+      for (int j=0; j<8; j++)
+        check(write_data[32*j+:32] === expected[t][row][j],"independent signed GEMM");
+      beats++;
+      if (write_last) begin
+        if (last_done_cycle >= 0) check(cycle-last_done_cycle == 8,"sustained II=8");
+        last_done_cycle = cycle; dones++;
+      end
+    end
+    // Inputs remain stable through the DUT sampling edge and routed clock delay.
+    #3;
+    if (cf) command_valid = 0;
+    if (df) read_data_valid = 0;
+    cycle++; check(cycle < 4000,"watchdog");
+  endtask
+
+  initial begin
+    if ($test$plusargs("HYBRID")) mode = 1;
+    else if ($test$plusargs("DUAL")) mode = 2;
+    else mode = 0;
+    check(mode >= 0 && mode <= 2,"legal workload mode"); prepare();
+    trace_fd = $fopen($sformatf("transactions_%0d.trace",mode),"w"); check(trace_fd != 0,"trace file");
+    // Let the vendor's 100 ns global startup reset finish before external reset.
+    #200; @(negedge clk); rst_n = 1;
+    while (dones < TILES) tick();
+    repeat (16) tick();
+    check(submitted == TILES && requests == TILES && beats == TILES*8,"accounting");
+    check(!memory_active && !write_valid,"drained");
+    $fclose(trace_fd); passed = 1;
+    $display("POWER WORKLOAD PASS mode=%0d seed=51a7c0de tiles=%0d cycles=%0d beats=%0d present_a=%0d present_b=%0d nonzero_a=%0d nonzero_b=%0d II=8",mode,TILES,cycle,beats,present_a,present_b,nonzero_a,nonzero_b);
+    $finish;
+  end
+  initial begin #50000; $fatal(1,"Power workload timeout"); end
+endmodule
diff --git a/experiments/pre_route_20261122/power/du_repair/du_gate.sv b/experiments/pre_route_20261122/power/du_repair/du_gate.sv
new file mode 100644
index 0000000..772fb6d
--- /dev/null
+++ b/experiments/pre_route_20261122/power/du_repair/du_gate.sv
@@ -0,0 +1,13 @@
+`timescale 1ns/1ps
+// Flat unit boundary prevents exported struct-port adapters from hiding errors.
+module du_gate(input logic clk, rst_n, in_valid,
+  input logic [$bits(du_tia_pkg::du_tia_input_t)-1:0] input_bits,
+  output logic out_valid,
+  output logic [$bits(du_tia_pkg::du_tia_output_t)-1:0] output_bits);
+  du_tia_pkg::du_tia_input_t packet_in;
+  du_tia_pkg::du_tia_output_t packet_out;
+  assign packet_in = input_bits;
+  assign output_bits = packet_out;
+  du_tia u_du (.clk(clk), .rst_n(rst_n), .in_valid(in_valid),
+    .in_packet(packet_in), .out_valid(out_valid), .out_packet(packet_out));
+endmodule
diff --git a/experiments/pre_route_20261122/power/du_repair/tb_du_gate.sv b/experiments/pre_route_20261122/power/du_repair/tb_du_gate.sv
new file mode 100644
index 0000000..224aed0
--- /dev/null
+++ b/experiments/pre_route_20261122/power/du_repair/tb_du_gate.sv
@@ -0,0 +1,144 @@
+`timescale 1ns/1ps
+module tb_du_gate;
+  import du_tia_pkg::*;
+  logic clk=0, rst_n=0, in_valid=0, out_valid;
+  always #5 clk=~clk;
+  du_tia_input_t input_bits='0;
+  du_tia_output_t output_bits;
+  du_gate dut(.*);
+  du_tia_output_t expected[0:3];
+  bit valid_pipe[0:3];
+  int sent=0, checked=0, resets=0;
+  bit passed=0;
+  logic [31:0] rng=32'h9412c731;
+  function automatic logic [31:0] randword();
+    rng=rng^(rng<<13); rng=rng^(rng>>17); rng=rng^(rng<<5);
+    return rng;
+  endfunction
+  function automatic logic [3:0] mask(input int n);
+    case(n%6)
+      0:return 4'h3; 1:return 4'h5; 2:return 4'h6;
+      3:return 4'h9; 4:return 4'ha; default:return 4'hc;
+    endcase
+  endfunction
+  // Independent ascending-coordinate reference, no DUT decode helper calls.
+  function automatic du_tia_output_t golden(input du_tia_input_t p);
+    du_tia_output_t e;
+    int ac,bc,rank;
+    bit ahit,bhit;
+    e='0; ac=0; bc=0;
+    if(p.mode==MODE_DENSE_DENSE) begin
+      e.payload.dense.dense_a=p.payload.dense.dense_a;
+      e.payload.dense.dense_b=p.payload.dense.dense_b;
+    end else begin
+      e.is_sparse=1;
+      for(int j=0;j<8;j++) begin
+        ahit=(p.mode==MODE_UNSTRUCTURED_2TO4)?p.payload.hybrid.a_bitmap[j]:p.payload.dual.a_bitmap[j];
+        bhit=(p.mode==MODE_UNSTRUCTURED_2TO4)?p.payload.hybrid.b_2to4_mask[j][p.k_position]:p.payload.dual.b_bitmap[j];
+        if(ahit) begin
+          e.payload.sparse.a.index[ac]=3'(j);
+          e.payload.sparse.a.value[ac]=(p.mode==MODE_UNSTRUCTURED_2TO4)?p.payload.hybrid.a_packed[ac]:p.payload.dual.a_packed[ac];
+          ac++;
+        end
+        if(bhit) begin
+          e.payload.sparse.b.index[bc]=3'(j);
+          if(p.mode==MODE_UNSTRUCTURED_2TO4) begin
+            rank=0;
+            for(int k=0;k<p.k_position;k++) rank+=int'(p.payload.hybrid.b_2to4_mask[j][k]);
+            e.payload.sparse.b.value[bc]=p.payload.hybrid.b_2to4_packed[j][rank];
+          end else e.payload.sparse.b.value[bc]=p.payload.dual.b_packed[bc];
+          bc++;
+        end
+      end
+      e.payload.sparse.a.count=4'(ac);
+      e.payload.sparse.b.count=4'(bc);
+    end
+    return e;
+  endfunction
+  always @(posedge clk) begin
+    if(!rst_n) begin
+      for(int i=0;i<4;i++) begin valid_pipe[i]=0; expected[i]='0; end
+    end else begin
+      for(int i=3;i>0;i--) begin valid_pipe[i]=valid_pipe[i-1]; expected[i]=expected[i-1]; end
+      valid_pipe[0]=in_valid;
+      expected[0]=in_valid?golden(input_bits):'0;
+      if(in_valid) sent++;
+    end
+    #2;
+    if(out_valid!==valid_pipe[3]) $fatal(1,"DU VALID FAIL sent=%0d",sent);
+    if(output_bits!==expected[3])
+      $fatal(1,"DU PAYLOAD FAIL sent=%0d checked=%0d actual=%h expected=%h",sent,checked,output_bits,expected[3]);
+    if(out_valid) checked++;
+  end
+  task automatic offer(input du_tia_input_t p,input bit v);
+    @(negedge clk); input_bits=p; in_valid=v;
+  endtask
+  initial begin : stimulus
+    du_tia_input_t p;
+    logic [31:0] sample;
+    #210; @(negedge clk); rst_n=1;
+    // First reproduce the failing A bitmap with unambiguous packed values.
+    p='0; p.mode=MODE_UNSTRUCTURED_UNSTRUCTURED;
+    p.payload.dual.a_bitmap=8'hf2; p.payload.dual.b_bitmap=8'ha8;
+    p.payload.dual.a_packed=64'h0807060504030201;
+    p.payload.dual.b_packed=64'h1817161514131211;
+    offer(p,1);
+    repeat(5) offer('0,0);
+    // Exhaust all A/B bitmap pairs; values include zero, extrema, and padding.
+    for(int a=0;a<256;a++) for(int b=0;b<256;b++) begin
+      p='0; p.mode=MODE_UNSTRUCTURED_UNSTRUCTURED;
+      p.payload.dual.a_bitmap=8'(a); p.payload.dual.b_bitmap=8'(b);
+      p.payload.dual.a_packed=64'h817f00ff0180fe42;
+      p.payload.dual.b_packed=64'h80ff7f0001aa5581;
+      offer(p,1);
+    end
+    // All A bitmaps, positions, and legal masks, plus independently mixed masks.
+    for(int a=0;a<256;a++) for(int k=0;k<4;k++) for(int m=0;m<6;m++) begin
+      p='0; p.mode=MODE_UNSTRUCTURED_2TO4; p.k_position=2'(k);
+      p.payload.hybrid.a_bitmap=8'(a);
+      p.payload.hybrid.a_packed=64'h807f00ff0181fe42;
+      for(int j=0;j<8;j++) begin
+        p.payload.hybrid.b_2to4_mask[j]=mask(m+j);
+        p.payload.hybrid.b_2to4_packed[j]={8'(j+64),8'(j)};
+      end
+      offer(p,1);
+    end
+    for(int t=0;t<4096;t++) begin
+      p='0;
+      case(t%3)
+        0: begin
+          p.mode=MODE_DENSE_DENSE;
+          for(int j=0;j<8;j++) begin
+            p.payload.dense.dense_a[j]=8'(randword());
+            p.payload.dense.dense_b[j]=8'(randword());
+          end
+        end
+        1: begin
+          p.mode=MODE_UNSTRUCTURED_2TO4; p.k_position=2'(randword());
+          p.payload.hybrid.a_bitmap=8'(randword());
+          for(int j=0;j<8;j++) begin
+            p.payload.hybrid.a_packed[j]=8'(randword());
+            p.payload.hybrid.b_2to4_mask[j]=mask(int'(randword()>>1));
+            p.payload.hybrid.b_2to4_packed[j]=16'(randword());
+          end
+        end
+        2: begin
+          p.mode=MODE_UNSTRUCTURED_UNSTRUCTURED;
+          p.payload.dual.a_bitmap=8'(randword()); p.payload.dual.b_bitmap=8'(randword());
+          for(int j=0;j<8;j++) begin
+            p.payload.dual.a_packed[j]=8'(randword()); p.payload.dual.b_packed[j]=8'(randword());
+          end
+        end
+      endcase
+      sample=randword(); offer(p,sample[0]||sample[1]);
+      if(t%257==0) begin
+        @(negedge clk); rst_n=0; in_valid=0; resets++;
+        @(negedge clk); rst_n=1;
+      end
+    end
+    repeat(6) offer('0,0);
+    passed=1;
+    $display("DU GATE PASS sent=%0d checked=%0d resets=%0d bitmap_pairs=65536 hybrid_cases=6144",sent,checked,resets);
+    $finish;
+  end
+endmodule
